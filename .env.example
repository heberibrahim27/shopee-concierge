# Shopee Affiliate Open API — já validado com a conta real do Ibrahim.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Instância Z-API usada pro concierge. No piloto atual, é a MESMA
# instância que já atende o BancaZAP (decisão dele, por não ter clientes
# reais no grupo ainda). Pra trocar de instância depois, só muda estas
# 3 linhas — nada de código muda.
#
# ZAPI_CLIENT_TOKEN também protege o webhook de entrada (achado real da
# Skill 25, 18/09/2026): a Z-API reenvia esse mesmo valor como header
# "Client-Token" em toda chamada de webhook, e src/app/api/webhook/zapi/route.ts
# agora rejeita qualquer POST sem esse header batendo. Sem essa variável
# configurada, o webhook fica fechado (nenhuma mensagem é processada).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# OpenAI — usado no reconhecimento de imagem (visão) e nas queries de busca.
OPENAI_API_KEY=
CONCIERGE_VISION_MODEL=gpt-4o-mini

# Frase que liga o fluxo do concierge dentro do número do BancaZAP —
# sem ela, qualquer foto/mensagem é ignorada por este projeto.
CONCIERGE_TRIGGER_PHRASE=QUERO ENCONTRAR

# URL completa (com token) que estava configurada em "Ao receber" na Z-API
# ANTES de trocar pra apontar pra este projeto — é o webhook real do
# BancaZAP (bzapprime.com.br). Todo evento recebido aqui é repassado pra
# essa URL também, pra não quebrar nada do BancaZAP. Sem isso configurado,
# o repasse é pulado (e o BancaZAP para de receber mensagem).
BANCAZAP_FORWARD_WEBHOOK_URL=

# Banco de dados do "Descontos Chegando" Growth OS (projeto Supabase
# babamanager-pro, reaproveitado por decisão do Ibrahim em 12/09/2026).
# SERVICE ROLE KEY: acesso total, ignora RLS — nunca expor no client,
# usar só em código de servidor (rotas de API, scripts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Site público (descontochegando.com.br) — ver ARQUITETURA-SITE.md.
# REVALIDATION_SECRET protege POST /api/internal/revalidate-catalog
# (chamado pelo Growth OS quando um snapshot muda, pra atualizar o preço
# no site sem esperar o fallback de 1h). SITE_BASE_URL é usado pelo
# PRÓPRIO pipeline de sourcing (scripts/source-deals.ts) pra saber pra
# onde mandar essa notificação — em produção, a URL do site na Vercel; em
# dev local, http://localhost:3000.
SITE_BASE_URL=
REVALIDATION_SECRET=
