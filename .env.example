# Shopee Affiliate Open API — já validado com a conta real do Ibrahim.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Instância Z-API usada pro concierge. No piloto atual, é a MESMA
# instância que já atende o BancaZAP (decisão dele, por não ter clientes
# reais no grupo ainda). Pra trocar de instância depois, só muda estas
# 3 linhas — nada de código muda.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# OpenAI — usado no reconhecimento de imagem (visão) e nas queries de busca.
OPENAI_API_KEY=
CONCIERGE_VISION_MODEL=gpt-4o-mini

# Frase que liga o fluxo do concierge dentro do número do BancaZAP —
# sem ela, qualquer foto/mensagem é ignorada por este projeto.
CONCIERGE_TRIGGER_PHRASE=QUERO ENCONTRAR

# URL completa (com token) que estava configurada em "Ao receber" na Z-API
# ANTES de trocar pra apontar pra este projeto — é o webhook real do
# BancaZAP (bzapprime.com.br). Todo evento recebido aqui é repassado pra
# essa URL também, pra não quebrar nada do BancaZAP. Sem isso configurado,
# o repasse é pulado (e o BancaZAP para de receber mensagem).
BANCAZAP_FORWARD_WEBHOOK_URL=
